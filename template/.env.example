# Base environment, shared by every app in this monorepo (ADR-0012).
# Copy to .env (git-ignored) and fill in. Apps add or override keys in apps/<app>/.env.
# Precedence: process environment > apps/<app>/.env > .env. Run with: tools/env/with-env.sh <app> -- <command>
# Format: KEY=value; no ${VAR} interpolation, no multi-line values. "# optional" marks a key that may stay empty.

# --- Claude API ---------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Shared data (ADR-0013) -------------------------------------------------------
# Root folder of the shared datasets; relative paths are relative to the repo root (REPO_ROOT).
SHARED_DATA_DIR=data

# --- Runtime ------------------------------------------------------------------
LOG_LEVEL=info
